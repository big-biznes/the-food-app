# Supabase dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Cloud Console → Credentials → OAuth client of type "Web application" (the same one entered in Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# Only needed for iOS builds
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
